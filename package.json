{
  "name": "bonsai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/ui"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -b packages/shared packages/server && cp packages/server/src/db/schema.sql packages/server/dist/db/schema.sql",
    "test": "npm run build && node --test \"packages/server/dist/**/*.test.js\"",
    "dev": "npm run build && node --no-warnings packages/server/dist/index.js",
    "dev:ui": "npm -w @bonsai/ui run dev",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
